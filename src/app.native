<!-- Blocks — top-level view (Task 13 high-fidelity shell).
     Structure:
       1. Onboarding overlay (welcome -> pick a local model), shown while
          the user has not completed onboarding.
       2. The main app: a header (avatar + New chat + Settings gear + nav)
          over a Chat screen (sidebar + single-click summaries + transcript
          + composer) and a Materials screen.
       3. A Settings modal (About / Model Context Protocol / Local Model +
          Watched Repositories), reached from the gear.
     Modals/overlays are plain <if test> gated panels (the SDK has no
     dedicated dialog element); their open state is testable Model state. -->
<column grow="1">

  <!-- ======================= ONBOARDING OVERLAY ======================= -->
  <if test="{needsOnboarding}">
    <column gap="16" padding="28" grow="1">

      <!-- Step 1: welcome splash (mockup 4). -->
      <if test="{onWelcomeStep}">
        <column gap="16" grow="1" cross="center">
          <column grow="1" />
          <icon name="app:sparkle" width="64" height="64" />
          <text size="heading" text-alignment="center">Blocks for Developers</text>
          <!-- Constrain the blurb to a narrow column so it wraps into a
               tidy, centered block (like the mockup) instead of spanning
               the full window width. -->
          <column max-width="620" cross="center">
            <text wrap="true" text-alignment="center">{welcomeBlurb}</text>
          </column>
          <column grow="1" />
          <button variant="primary" on-press="onboard_next">Get Started</button>
        </column>
      </if>

      <!-- Step 2: pick a local model (mockup 5). -->
      <if test="{onPickModelStep}">
        <column gap="12" grow="1">
          <text size="heading">Pick a local model</text>
          <!-- Wrap the subtitle so the full sentence is readable (not a
               single truncated line). -->
          <text wrap="true">Blocks for Developers runs on a model that lives on your machine. We've recommended the most capable one your computer can run — download it, or pick another.</text>

          <scroll grow="1">
            <column gap="6">
              <for each="modelChoices" key="index" as="m">
                <!-- Each option is a card; the SELECTED one is bordered
                     (via `selected`), the others rest quiet. Tapping a card
                     selects that model. Kept compact (tight padding/gaps,
                     default-size name, single caption for size/RAM) so all
                     three fit without scrolling. -->
                <card selected="{m.selected}" on-press="select_model:{m.index}">
                  <column gap="2" padding="8">
                    <row cross="center" gap="8">
                      <text size="heading" grow="1">{m.name}</text>
                      <if test="{m.recommended}">
                        <badge>Recommended</badge>
                      </if>
                      <badge>{m.tierLabel}</badge>
                    </row>
                    <text wrap="true">{m.blurb}</text>
                    <text>{m.specLine}</text>
                  </column>
                </card>
              </for>
            </column>
          </scroll>

          <status-bar>{modelStatusText}</status-bar>
          <button variant="primary" on-press="onboard_finish" disabled="{installDisabled}">{installLabel}</button>
        </column>
      </if>

    </column>
  </if>

  <!-- ============================ MAIN APP ============================ -->
  <if test="{onboarded}">
    <column grow="1">

      <!-- A slim spacer above the top bar so the "Blocks" title clears the
           macOS window traffic-light controls. -->
      <column height="16" />

      <!-- Top bar: title + nav. -->
      <row cross="center" gap="8" padding="12">
        <text size="heading" grow="1">Blocks</text>
        <button size="sm" variant="ghost" on-press="show_chat">Chat</button>
        <button size="sm" variant="ghost" on-press="show_materials">Materials</button>
        <button size="sm" variant="ghost" on-press="open_settings">Settings</button>
      </row>

      <!-- ========================= CHAT SCREEN ========================= -->
      <if test="{onChatScreen}">
        <row gap="0" grow="1">

          <!-- Left sidebar: identity header + New chat + date-grouped history. -->
          <column gap="10" padding="12" width="300" background="surface_subtle">

            <!-- Panel header: avatar circle + username. -->
            <row cross="center" gap="8">
              <avatar>{avatarInitials}</avatar>
              <text grow="1">{usernameText}</text>
            </row>

            <button variant="secondary" on-press="new_chat" icon="plus">New chat</button>

            <!-- Chat history, newest-first. A date-group header prints above
                 the first row of each bucket; the active chat is highlighted. -->
            <scroll grow="1">
              <column gap="4">
                <if test="{hasChats}">
                  <for each="chatList" key="id" as="c">
                    <column gap="4">
                      <if test="{c.groupHead}">
                        <status-bar>{c.groupLabel}</status-bar>
                      </if>
                      <card selected="{c.active}" on-press="select_chat:{c.id}">
                        <row cross="start" gap="6" padding="8">
                          <icon name="file-text" width="14" height="14" foreground="text_muted" />
                          <!-- Title + preview as a growing column so the
                               title wraps to multiple lines instead of
                               truncating (a wrappable text needs a bounded
                               width, which the column gives it). -->
                          <column gap="2" grow="1">
                            <text wrap="true">{c.title}</text>
                            <if test="{c.hasPreview}">
                              <text size="sm" foreground="text_muted" wrap="true">{c.preview}</text>
                            </if>
                          </column>
                        </row>
                      </card>
                    </column>
                  </for>
                </if>
                <else>
                  <status-bar>Your conversations are saved locally.</status-bar>
                </else>
              </column>
            </scroll>
          </column>

          <!-- Main chat column. -->
          <column gap="12" padding="16" grow="1">

            <!-- Single-click summary cards (Task 11). -->
            <text size="sm" foreground="text_muted">SINGLE-CLICK SUMMARIES</text>
            <row gap="12" cross="stretch">
              <for each="summaryCards" key="tag" as="c">
                <card grow="1" on-press="start_summary:{c.tag}">
                  <column gap="6" padding="12">
                    <icon name="{c.icon}" width="20" height="20" foreground="accent" />
                    <text>{c.label}</text>
                    <text size="sm" foreground="text_muted" wrap="true">{c.blurb}</text>
                  </column>
                </card>
              </for>
            </row>

            <!-- Conversation title (shown once a chat is active). -->
            <if test="{hasChatTitle}">
              <text size="heading">{chatTitleText}</text>
            </if>

            <!-- Conversation transcript. User messages are right-aligned blue
                 bubbles with an avatar; assistant replies are left-aligned
                 plain text with a bot glyph. Each message offers Save to Snippets. -->
            <scroll grow="1">
              <column gap="16">
                <if test="{chatEmpty}">
                  <row cross="center" gap="6">
                    <text foreground="text_muted">Or use the input below</text>
                    <icon name="arrow-down" width="16" height="16" foreground="text_muted" />
                  </row>
                </if>
                <for each="messagesSlice" key="id" as="msg">
                  <if test="{msg.isUser}">
                    <!-- User: right-aligned bubble + avatar (no Save to
                         Snippets — that's offered on model replies only). -->
                    <row main="end" cross="start" gap="8">
                      <column cross="end" gap="2" grow="1">
                        <column background="accent" foreground="accent_text" radius="lg" padding="10" cross="start">
                          <text foreground="accent_text" wrap="true">{msg.content}</text>
                        </column>
                      </column>
                      <avatar>{avatarInitials}</avatar>
                    </row>
                  </if>
                  <else>
                    <!-- Assistant: left-aligned, bot glyph, plain text. -->
                    <row main="start" cross="start" gap="8">
                      <icon name="terminal" width="18" height="18" foreground="text_muted" />
                      <column gap="2" grow="1" cross="start">
                        <text wrap="true">{msg.content}</text>
                        <button size="sm" variant="secondary" on-press="save_to_snippets:{msg.index}">Save to Snippets</button>
                      </column>
                    </row>
                  </else>
                </for>
                <!-- The in-progress assistant reply, as tokens stream in. -->
                <if test="{isStreaming}">
                  <row main="start" cross="start" gap="8">
                    <icon name="terminal" width="18" height="18" foreground="text_muted" />
                    <text grow="1" wrap="true">{streamingText}</text>
                  </row>
                </if>
              </column>
            </scroll>

            <!-- A muted status line (thinking / searching / errors) shown only
                 when there's something worth saying — no box. -->
            <if test="{showChatStatus}">
              <text size="sm" foreground="text_muted">{chatStatusText}</text>
            </if>

            <!-- Composer: a single rounded input with a leading glyph and a
                 trailing send button (no separate Send label). -->
            <row cross="center" gap="8" background="surface_subtle" radius="lg" padding="6">
              <icon name="terminal" width="18" height="18" foreground="text_muted" />
              <text-field
                placeholder="Ask Blocks about your recent work"
                on-input="chat_input_edit"
                on-submit="send_chat"
                grow="1" />
              <button variant="ghost" size="icon" icon="send" label="Send" on-press="send_chat" disabled="{sendDisabled}" />
            </row>
          </column>
        </row>
      </if>

      <!-- ======================= MATERIALS SCREEN ======================= -->
      <!-- High-fidelity redesign (materials mockup): an identity pill + a
           large centered search pill in the header, a rounded-card sidebar
           list with language glyphs, a big rounded material card (header +
           Start Copilot Chat + code), an "All Context" pair of rounded
           cards, a right-edge action rail, and a floating "+" FAB overlaid
           on the sidebar (via a <stack>). Layered surfaces + lg radii give
           the soft, grouped look; behavior/bindings are unchanged. -->
      <if test="{onMaterialsScreen}">
        <column gap="12" padding="16" grow="1">

          <!-- Materials header: identity pill on the left, a large centered
               search pill in the middle. (The Chat/Materials/Settings nav
               lives in the shared top bar above.) -->
          <row cross="center" gap="12">
            <row cross="center" gap="8" background="surface_subtle" radius="lg" padding="6">
              <avatar>{avatarInitials}</avatar>
              <text>{usernameText}</text>
            </row>
            <column grow="1" cross="center">
              <row cross="center" gap="8" background="surface_subtle" radius="xl" padding="10" width="480">
                <search-field
                  placeholder="Find materials…"
                  on-input="snippet_search_edit"
                  grow="1" />
              </row>
            </column>
            <!-- A spacer matching the identity pill keeps the search pill
                 visually centered in the row. -->
            <column width="140" />
          </row>

          <row gap="16" grow="1">

            <!-- ===================== SIDEBAR ===================== -->
            <!-- Wrapped in a <stack> so the "+" FAB floats over the list's
                 bottom-left corner (mockup) instead of sitting inline. -->
            <stack width="320">
              <column gap="10" grow="1">

                <!-- Sidebar header: title + count pill + language ({}) and
                     sort (clock) icon buttons. -->
                <row cross="center" gap="6">
                  <text grow="1">Saved Materials</text>
                  <badge>{snippetCount}</badge>
                  <button size="icon" variant="ghost" icon="app:braces" label="Filter by language" on-press="toggle_lang_menu" />
                  <button size="icon" variant="ghost" icon="clock" label="Sort" on-press="toggle_sort_menu" />
                </row>

                <!-- SORT BY menu (rounded floating card, mockup). The header
                     shows the active sort so the icon-only trigger stays
                     legible. -->
                <if test="{sortMenuOpen}">
                  <card radius="lg" background="surface" padding="6">
                    <column gap="2">
                      <status-bar>SORT BY · {sortLabel}</status-bar>
                      <button size="sm" variant="ghost" icon="clock" on-press="sort_recent">Recent</button>
                      <button size="sm" variant="ghost" on-press="sort_alphabetical">Alphabetical</button>
                    </column>
                  </card>
                </if>

                <!-- Language filter menu: "All" first, then languages in use.
                     The header shows the active filter. -->
                <if test="{langMenuOpen}">
                  <card radius="lg" background="surface" padding="6">
                    <column gap="2">
                      <status-bar>LANGUAGE · {langFilterLabel}</status-bar>
                      <button size="sm" variant="ghost" on-press="clear_lang_filter">All</button>
                      <for each="languageList" key="name" as="l">
                        <button size="sm" variant="ghost" on-press="set_lang_filter:{l.filterIndex}">{l.name}</button>
                      </for>
                    </column>
                  </card>
                </if>

                <!-- The list of saved materials, as rounded cards. -->
                <scroll grow="1">
                  <column gap="6">
                    <if test="{hasSnippets}">
                      <for each="snippetList" key="id" as="s">
                        <card selected="{s.selected}" radius="lg" on-press="select_snippet:{s.id}">
                          <row cross="start" gap="8" padding="10">
                            <!-- Generic accent-tinted glyph per card. -->
                            <icon name="file-text" width="18" height="18" foreground="accent" />
                            <column gap="3" grow="1">
                              <text wrap="true">{s.title}</text>
                              <text size="sm" foreground="text_muted" wrap="true">{s.cardBlurb}</text>
                            </column>
                          </row>
                        </card>
                      </for>
                    </if>
                    <if test="{noSnippets}">
                      <card radius="lg" background="surface_subtle" padding="12">
                        <text size="sm" foreground="text_muted" wrap="true">No materials yet. Save a snippet from a chat, or add one with the + button.</text>
                      </card>
                    </if>
                  </column>
                </scroll>
              </column>

              <!-- Floating "+" FAB, docked bottom-left over the sidebar. -->
              <column grow="1" main="end">
                <row main="start">
                  <button size="icon" variant="primary" icon="plus" label="New material" on-press="open_new_snippet" />
                </row>
              </column>
            </stack>

            <!-- ===================== MAIN PANEL ===================== -->
            <row gap="10" grow="1">
              <column gap="12" grow="1">
                <if test="{snippetSelected}">

                  <!-- The material card: header (glyph + title + saved-ago +
                       {} button) + Start Copilot Chat + code with numbers. -->
                  <card radius="lg" background="surface_subtle" grow="1">
                    <column gap="12" padding="16" grow="1">
                      <row cross="start" gap="10">
                        <column gap="2" grow="1">
                          <text size="heading">{selectedTitle}</text>
                          <text size="sm" foreground="text_muted">{selectedSavedAgo}</text>
                        </column>
                      </row>

                      <row cross="center" gap="8">
                        <button size="sm" variant="secondary" icon="terminal" on-press="start_copilot_chat">Start Copilot Chat</button>
                      </row>

                      <scroll grow="1">
                        <code source="{selectedContent}" line-numbers="true" />
                      </scroll>
                    </column>
                  </card>

                  <!-- All Context: Annotations + Text Expander, rounded cards.
                       A subsection label sized BETWEEN the small status-bar
                       labels (ANNOTATIONS / TEXT EXPANDER) and the heading-
                       sized material title: default body text scaled up ~1.3x
                       via a <span> (the text `size` scale has no rung between
                       default and `heading`). -->
                  <text><span scale="1.3">All Context</span></text>
                  <card radius="lg" background="surface_subtle">
                    <column gap="6" padding="12">
                      <status-bar>ANNOTATIONS</status-bar>
                      <text wrap="true">{selectedAnnotation}</text>
                    </column>
                  </card>
                  <card radius="lg" background="surface_subtle">
                    <column gap="6" padding="12">
                      <status-bar>TEXT EXPANDER</status-bar>
                      <text wrap="true">{selectedTextExpander}</text>
                    </column>
                  </card>
                </if>
                <if test="{noSnippetSelected}">
                  <card radius="lg" background="surface_subtle" grow="1">
                    <column gap="8" padding="16" grow="1" main="center" cross="center">
                      <icon name="app:braces" width="40" height="40" foreground="text_muted" />
                      <text foreground="text_muted" text-alignment="center" wrap="true">Select a material to view it, or create one with the + button.</text>
                    </column>
                  </card>
                </if>
              </column>

              <!-- Right action rail: edit / copy / delete (mockup). Shown
                   only when a material is selected. -->
              <if test="{snippetSelected}">
                <column gap="8">
                  <button size="icon" variant="ghost" icon="edit" label="Edit" on-press="open_edit_snippet" />
                  <button size="icon" variant="ghost" icon="copy" label="Copy" on-press="copy_snippet" />
                  <button size="icon" variant="ghost" icon="trash" label="Delete" on-press="request_delete_snippet" />
                </column>
              </if>
            </row>
          </row>

          <!-- A muted status line (toast) when there's something to say. -->
          <if test="{hasSnippetStatus}">
            <text size="sm" foreground="text_muted">{snippetStatus}</text>
          </if>
        </column>
      </if>
    </column>
  </if>

  <!-- The material ADD/EDIT editor is now a SEPARATE OS window (like
       Settings), built in Zig by `editorWindowView` in main.zig — the "+"
       FAB (open_new_snippet) and the pencil (open_edit_snippet) declare it.
       Markup binds only the main canvas, so it cannot live here. -->

  <!-- The set-language modal was removed: the material editor window is the
       single place to set a snippet's language (the `{}` button + this modal
       were duplicate functionality). The sidebar language FILTER still uses
       the language list; snippet language is edited in the editor. -->

  <!-- The Settings UI is a SEPARATE OS window (Task 13), built in Zig by
       `window_view`/`windows_fn` in main.zig — the header "Settings" button
       (open_settings) declares it. Markup binds only the main canvas, so it
       cannot live here. -->

</column>
